rules_version = '2';

// Solo el servidor de Fusion accede a Firestore. Se autentica con un token personalizado
// que lleva el claim `fusion_server` (ver server/auth/serverFirestoreAuth.ts).
// El navegador no usa Firestore directamente: todo pasa por la API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.fusion_server == true;
    }
  }
}
