{
  "name": "fusion-crm-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npx --yes prisma generate --schema=packages/db/prisma && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && test -f dist/index.html && test -f dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "postinstall": "npx --yes prisma generate --schema=packages/db/prisma",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.4.1",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.103.2",
    "@trpc/server": "^11.19.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.6",
    "bullmq": "^6.3.4",
    "date-fns": "^4",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^13.2.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sip.js": "^0.21.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
