# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Autenticación (Firebase Admin) ────────────────────────────
# Ruta al JSON de una cuenta de servicio del proyecto Firebase con el rol
# "Service Account Token Creator". Sin ella nadie puede iniciar sesión y, con las
# reglas de firestore.rules desplegadas, el servidor no puede leer Firestore.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# ── Database (Prisma / Postgres) ──────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
# Contraseña de Postgres para docker-compose (obligatoria)
DB_PASSWORD=

# ── Despliegue en VPS (docker-compose.minimal.yml, ver DEPLOY.md) ──
# Dominio donde se abrirá el sistema (debe apuntar a la IP del VPS)
DOMAIN=
# Correo para el certificado HTTPS (Let's Encrypt avisa ahí si hay problemas)
ACME_EMAIL=
# Respaldos: hora diaria (0-23, hora de Colombia), días que se guardan y copia externa opcional
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
# Ej.: gdrive:fusion-respaldos (requiere secrets/rclone/rclone.conf, ver DEPLOY.md)
BACKUP_RCLONE_REMOTE=
# Dónde viven clientes, cotizaciones y proyectos: firestore (por defecto) o postgres
DATA_BACKEND=firestore

# ── Chat web (widget para el sitio web, ver DEPLOY.md → Canales) ──
# Clave que va en el código del widget (data-key). Vacía = cualquiera puede usarlo.
WEBCHAT_PUBLIC_KEY=
# Sitios donde se incrusta el chat (origen exacto, separados por coma)
WEBCHAT_ALLOWED_ORIGINS=https://fusioncg.com,https://www.fusioncg.com
WEBCHAT_PRIMARY_COLOR=#2563eb
WEBCHAT_POSITION=right

# ── Meta (WhatsApp / Instagram / Messenger) ───────────────────
META_APP_ID=
# Obligatorio para recibir mensajes: el webhook rechaza todo evento sin firma válida
META_APP_SECRET=
# Texto secreto que también se pone en el panel de Meta al suscribir el webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# WhatsApp Cloud API: identificador del número y token permanente (usuario del sistema)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Portal del cliente: ingreso con cédula/NIT + código ───────
# El código llega por WhatsApp (plantilla de categoría Autenticación aprobada en Meta, con botón
# "Copiar código") y/o por correo. Sin ninguno de los dos, solo funcionan los enlaces que genera el equipo.
PORTAL_CODE_TEMPLATE=codigo_acceso
PORTAL_CODE_LANGUAGE=es
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente, ej. "Fusión Comunicación Gráfica <pedidos@tudominio.com>"
SMTP_FROM=
# Número de WhatsApp público (solo dígitos, ej. 573001234567) para el botón del chat web
WHATSAPP_PUBLIC_NUMBER=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
MESSENGER_PAGE_ID=
# Token de la página de Facebook (también atiende el Instagram conectado a ella)
MESSENGER_PAGE_ACCESS_TOKEN=

# ── Telefonía y Voz (Asterisk ARI / WebRTC) — Etapa 17.1 ──────
# Si faltan estas variables, el módulo de voz se apaga limpiamente.
# Asterisk usa la red del host; los contenedores lo alcanzan por host.docker.internal.
# Sin ASTERISK_ARI_PASSWORD el módulo de voz queda apagado.
ASTERISK_ARI_URL=http://host.docker.internal:8088
ASTERISK_ARI_WS_URL=ws://host.docker.internal:8088/ari/events?app=fusion-voz&subscribeAll=false
ASTERISK_ARI_USERNAME=fusion
ASTERISK_ARI_PASSWORD=
# Debe coincidir con Stasis(fusion-voz) en infra/asterisk/etc/extensions.conf
ASTERISK_ARI_APP=fusion-voz
ASTERISK_SIP_HOST=pbx.fusioncg.com
ASTERISK_SIP_PORT=5060
# Dominio SIP con que se registran los softphones del navegador (normalmente el mismo host)
VOICE_SIP_DOMAIN=pbx.fusioncg.com
# Traefik termina TLS y reenvía a Asterisk :8088/ws
ASTERISK_WEBRTC_WSS_URL=wss://pbx.fusioncg.com/ws
# Troncal SIP del operador: la registra Asterisk al arrancar (cambiarla exige reiniciarlo)
TRUNK_NAME=
TRUNK_PROVIDER=
TRUNK_SIP_HOST=
TRUNK_SIP_PORT=5060
TRUNK_USERNAME=
TRUNK_PASSWORD=
TRUNK_MAX_CHANNELS=10
# Cómo espera el operador el número marcado: NATIONAL (3001234567), INTERNATIONAL (573001234567) o E164 (+57…)
TRUNK_DIAL_FORMAT=NATIONAL
# IP del operador: es la única que puede hablar con el puerto 5060 (la usa infra/scripts/bootstrap-vps.sh)
TRUNK_OPERATOR_IP=
# IP pública del servidor: Asterisk la anuncia para que el audio no se corte
PUBLIC_IP=
# Número con que salen las llamadas (E.164, ej. +576068801234)
VOICE_CALLER_ID=
# Cifra las contraseñas SIP en la base. Genérela una vez (openssl rand -hex 32) y no la cambie:
# si se pierde, hay que volver a crear las extensiones.
SECRET_ENCRYPTION_KEY=
VOICE_RECORDINGS_PATH=/var/spool/asterisk/monitor
VOICE_STORAGE_BUCKET=voice-recordings
VOICE_DEFAULT_RECORDING_RETENTION_DAYS=180
VOICE_DEFAULT_COUNTRY_CODE=57
VOICE_MAX_CHANNELS_PER_TRUNK=30
VOICE_AI_AGENT_TIMEOUT_SECONDS=300
VOICE_SLA_WAIT_SECONDS=30

# ── Notificaciones push ───────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sistemas@fusioncg.com

# ── IA (Gemini) ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_REASONING=gemini-pro-latest
GEMINI_MODEL_EMBEDDING=text-embedding-004
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=30000
AI_MONTHLY_BUDGET_COP=
AI_PROVIDER=gemini

# ── Tiempo real ───────────────────────────────────────────────
REALTIME_SSE_HEARTBEAT_SECONDS=25
REALTIME_REPLAY_BUFFER_SIZE=200
REALTIME_REDIS_CHANNEL_PREFIX=fusion:rt
REALTIME_MAX_CONNECTIONS_PER_USER=4

# ── Chat ──────────────────────────────────────────────────────
CHAT_ATTACHMENT_MAX_MB=25
CHAT_RETENTION_MONTHS_DEFAULT=24
CHAT_MESSAGE_MAX_LENGTH=4000

# ── Llamadas (LiveKit) — opcionales ───────────────────────────
LIVEKIT_URL=wss://meet.fusioncg.com
NEXT_PUBLIC_LIVEKIT_URL=wss://meet.fusioncg.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=15
LIVEKIT_MAX_PARTICIPANTS=16
LIVEKIT_RECORDING_ENABLED=false
TURN_REALM=fusioncg.com
TURN_SECRET=
TURN_UDP_PORT_RANGE=50000-50200

# ── Home y rendimiento ────────────────────────────────────────
HOME_DEFAULT_START_PAGE=home
PERFORMANCE_TASK_GREEN_THRESHOLD=85
PERFORMANCE_TASK_AMBER_THRESHOLD=70
PERFORMANCE_TASK_GRACE_HOURS=4
CAPACITY_HEALTHY_MIN=60
CAPACITY_TIGHT_MIN=85
CAPACITY_OVERLOAD_MIN=95

# Costos (pantalla Comunicaciones → Costos de IA y mensajería). Valores estimados; ajústelos
# a las tarifas vigentes de Google (Gemini) y Meta (WhatsApp).
# AI_PRICE_INPUT_PER_M_USD=0.3
# AI_PRICE_OUTPUT_PER_M_USD=2.5
# WHATSAPP_TEMPLATE_PRICE_USD=0.0008
# USD_COP=4000

# Adjuntos del portal: en disco (volumen uploads, con respaldo) o en Firebase Storage
# FILE_STORAGE=local
# UPLOADS_DIR=/app/uploads

# Google Drive de la empresa para archivos del equipo (DEPLOY.md §9). Sin esto: disco del servidor.
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_USE_SERVICE_ACCOUNT=false
