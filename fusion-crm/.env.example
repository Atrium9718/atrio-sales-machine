# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Database (Prisma / Postgres) ──────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ── Chat web ──────────────────────────────────────────────────
WEBCHAT_PUBLIC_KEY=
WEBCHAT_ALLOWED_ORIGINS=https://fusioncg.com,https://www.fusioncg.com
WEBCHAT_SESSION_SECRET=

# ── Meta (Instagram / Messenger) ──────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# ── Telefonía y Voz (Asterisk ARI / WebRTC) — Etapa 17.1 ──────
# Si faltan estas variables, el módulo de voz se apaga limpiamente.
ASTERISK_ARI_URL=http://asterisk:8088
ASTERISK_ARI_WS_URL=ws://asterisk:8088/ari/events
ASTERISK_ARI_USERNAME=asterisk
ASTERISK_ARI_PASSWORD=secret
ASTERISK_ARI_APP=fusion-voice
ASTERISK_SIP_HOST=sip.fusioncg.com
ASTERISK_SIP_PORT=5060
ASTERISK_WEBRTC_WSS_URL=wss://voice.fusioncg.com:8089/ws
VOICE_RECORDINGS_PATH=/var/spool/asterisk/monitor
VOICE_STORAGE_BUCKET=voice-recordings
VOICE_DEFAULT_RECORDING_RETENTION_DAYS=180
VOICE_DEFAULT_COUNTRY_CODE=57
VOICE_MAX_CHANNELS_PER_TRUNK=30
VOICE_AI_AGENT_TIMEOUT_SECONDS=300
VOICE_SLA_WAIT_SECONDS=30

# ── Notificaciones push ───────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sistemas@fusioncg.com

# ── IA (Gemini) ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_REASONING=gemini-pro-latest
GEMINI_MODEL_EMBEDDING=text-embedding-004
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=30000
AI_MONTHLY_BUDGET_COP=
AI_PROVIDER=gemini

# ── Tiempo real ───────────────────────────────────────────────
REALTIME_SSE_HEARTBEAT_SECONDS=25
REALTIME_REPLAY_BUFFER_SIZE=200
REALTIME_REDIS_CHANNEL_PREFIX=fusion:rt
REALTIME_MAX_CONNECTIONS_PER_USER=4

# ── Chat ──────────────────────────────────────────────────────
CHAT_ATTACHMENT_MAX_MB=25
CHAT_RETENTION_MONTHS_DEFAULT=24
CHAT_MESSAGE_MAX_LENGTH=4000

# ── Llamadas (LiveKit) — opcionales ───────────────────────────
LIVEKIT_URL=wss://meet.fusioncg.com
NEXT_PUBLIC_LIVEKIT_URL=wss://meet.fusioncg.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=15
LIVEKIT_MAX_PARTICIPANTS=16
LIVEKIT_RECORDING_ENABLED=false
TURN_REALM=fusioncg.com
TURN_SECRET=
TURN_UDP_PORT_RANGE=50000-50200

# ── Home y rendimiento ────────────────────────────────────────
HOME_DEFAULT_START_PAGE=home
PERFORMANCE_TASK_GREEN_THRESHOLD=85
PERFORMANCE_TASK_AMBER_THRESHOLD=70
PERFORMANCE_TASK_GRACE_HOURS=4
CAPACITY_HEALTHY_MIN=60
CAPACITY_TIGHT_MIN=85
CAPACITY_OVERLOAD_MIN=95
