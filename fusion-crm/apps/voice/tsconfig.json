{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@fusion/core/*": ["../../packages/core/*"],
      "@fusion/db/*": ["../../packages/db/*"],
      "@fusion/contracts/*": ["../../packages/contracts/*"],
      "@fusion/config": ["../../packages/config/src/env.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
