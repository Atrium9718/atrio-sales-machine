# ─────────────────────────────────────────────────────────────
# Fusión W2P — Variables de entorno
# En Hostinger se cargan en hPanel → Sitios web → Node.js → Variables de entorno.
# En local: copia este archivo como .env
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Neon / Supabase). Copia la "connection string" con sslmode=require
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/fusion?sslmode=require"
# Conexiones simultáneas máximas al pool (5 es suficiente en hosting compartido)
DB_POOL_MAX=5
# Aplica migraciones automáticamente al arrancar (true por defecto)
AUTO_MIGRATE=true

# URL pública de la tienda (se usa en enlaces de retorno de pagos)
APP_URL="https://tudominio.com"

# Correos con rol ADMIN (separados por coma). Deben iniciar sesión con Google.
ADMIN_EMAILS="andresepulveda718@gmail.com"

# Inteligencia Artificial (Gemini)
GEMINI_API_KEY=""

# ── Pasarelas de pago ─────────────────────────────────────────
# Modo: sandbox | production
WOMPI_MODE="sandbox"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
# Secreto de eventos: obligatorio para validar el webhook /api/checkout/webhook/wompi
WOMPI_EVENTS_SECRET=""

BOLD_MODE="sandbox"
BOLD_API_KEY=""
# Llave secreta: obligatoria para validar el webhook /api/checkout/webhook/bold
BOLD_SECRET_KEY=""
BOLD_INTEGRITY_KEY=""

# Solo para pruebas: permite el botón "simular pago aprobado". NUNCA en producción.
PAYMENT_SIMULATION=false

# ── Integraciones de marketing (opcionales) ───────────────────
META_ACCESS_TOKEN=""
META_PAGE_ID=""
META_INSTAGRAM_ACCOUNT_ID=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_SERVICE_ACCOUNT_KEY=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
RESEND_API_KEY=""

# ── Envíos Skydropx (opcional) ────────────────────────────────
SKYDROPX_API_KEY=""
SKYDROPX_API_SECRET=""
SKYDROPX_ORG_ID=""
SKYDROPX_WEBHOOK_SECRET=""
